{
  "name": "authenticator-desktop",
  "version": "1.0.0",
  "description": "Sleek and secure desktop 2FA Authenticator",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win"
  },
  "build": {
    "appId": "com.authenticator.client",
    "productName": "Authenticator Client",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "portable"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "index.css",
      "renderer.js"
    ]
  },
  "keywords": [
    "2fa",
    "totp",
    "authenticator",
    "electron"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "jsqr": "^1.4.0",
    "otpauth": "^9.3.2",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "electron": "^31.3.0",
    "electron-builder": "^26.15.3"
  }
}
